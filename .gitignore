# Dependencies — NEVER commit these
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json  # optional: remove this line if you want to track it

# Runtime data
data/
*.pid
*.seed
*.pid.lock

# Build output
dist/
build/
.next/
out/

# Environment variables — never commit secrets
.env
.env.local
.env.*.local
!.env.example

# Logs
logs/
*.log

# Coverage
coverage/
.nyc_output/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
